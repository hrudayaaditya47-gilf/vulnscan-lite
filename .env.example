# Copy this to .env (in the same folder as docker-compose.yml) and fill
# in real values before running `docker compose up`. docker-compose
# automatically loads a .env file in its own directory.

# REQUIRED — session cookies are signed with this. Generate a real one with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=

# The frontend's public URL, so the API's CORS policy allows it.
# For local docker-compose use, the default (http://localhost:8080) is fine.
CORS_ORIGINS=http://localhost:8080

# The API's public URL, baked into the frontend's JS bundle at build time.
# For local docker-compose use, the default (http://localhost:5000) is fine.
# For a real deployment, this must be the API's actual public HTTPS URL.
VITE_API_BASE=http://localhost:5000
